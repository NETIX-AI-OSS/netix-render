{% import "components/section_h2.j2" as heading %}
{% macro exceptions_table(section) -%}
{{ heading.section_h2(section.title, section.icon, section.subtitle) }}
<table>
  <tr>
    <th>#</th>
    <th>Event</th>
    <th>Asset</th>
    <th>AI assessment</th>
    <th>Owner</th>
  </tr>
  {% for row in section.rows %}
  <tr>
    <td>{{ row.rank }}</td>
    <td class="b">{{ row.event }}</td>
    <td>{{ row.asset }}</td>
    <td>{{ row.assessment }}</td>
    <td>{{ row.owner }}</td>
  </tr>
  {% endfor %}
</table>
{%- endmacro %}
