{% macro timestamp(meta) -%}
{% if meta.dir == "rtl" %}<bdi dir="ltr">{% endif %}{{ meta.generated_at | display_datetime(meta.language, meta.dir, meta.timezone_label) }}{% if meta.dir == "rtl" %}</bdi>{% endif %}
{%- endmacro %}
{% macro genbar(meta) -%}
{% set copy = meta.language | report_labels -%}
<div class="genbar">
  <span class="gb-badge">⬡ {{ copy.system_generated }}</span><span>{{ copy.report_id }}&nbsp;<b>{{ meta.report_id }}</b></span
  ><span>{{ copy.generated }}&nbsp;<b>{{ timestamp(meta) }}</b></span
  ><span>{{ copy.engine }} {{ meta.engine_version }} · {{ copy.manual_edits | format(count=meta.manual_edits) }}</span><span class="gb-right">{% if meta.sha256 %}{{ copy.fingerprint }}{% else %}{{ copy.automatic }}{% endif %}</span>
</div>
{%- endmacro %}
