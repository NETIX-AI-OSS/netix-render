{% macro genbar(meta) -%}
<div class="genbar">
  <span class="gb-badge">⬡ SYSTEM-GENERATED</span><span>Report ID&nbsp;<b>{{ meta.report_id }}</b></span
  ><span>Generated&nbsp;<b>{{ meta.generated_at | display_datetime }} {{ meta.timezone_label }}</b></span
  ><span>Engine {{ meta.engine_version }} · {{ meta.manual_edits }} manual edits</span><span class="gb-right">✓ SHA-256 verified</span>
</div>
{%- endmacro %}
