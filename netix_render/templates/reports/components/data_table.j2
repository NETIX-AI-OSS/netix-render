{% import "components/section_h2.j2" as heading %}
{% macro data_cell(cell) -%}
{% set classes = ((cell.status or "") ~ (" b" if cell.bold else "")).strip() %}
<td{% if classes %} class="{{ classes }}"{% endif %}>{% if cell.text %}{{ cell.text }}{% if cell.pill %} {% endif %}{% endif %}{% if cell.pill %}<span class="pill p-{{ cell.pill.level }}">{{ cell.pill.label }}</span>{% endif %}</td>
{%- endmacro %}
{% macro data_table(panel) -%}
{% if panel.title %}{{ heading.section_h2(panel.title, panel.icon, panel.subtitle) }}{% endif %}
<table>
  <tr>
    {% for column in panel.columns %}<th>{{ column }}</th>{% endfor %}
  </tr>
  {% for row in panel.rows %}
  <tr>
    {% for cell in row %}{{ data_cell(cell) }}{% endfor %}
  </tr>
  {% endfor %}
</table>
{%- endmacro %}
