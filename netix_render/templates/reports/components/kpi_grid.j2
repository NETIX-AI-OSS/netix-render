{% macro kpi_grid(section) -%}
<div class="kpis">
  {% for item in section.items %}
  <div class="kpi">
    <div class="v {{ item.status }}">{{ item.value }}</div>
    <div class="l">{{ item.label }}</div>
    {% if item.note %}<div class="s {{ item.note_status or item.status }}">{{ item.note }}</div>{% endif %}
  </div>
  {% endfor %}
</div>
{%- endmacro %}
