{% macro buttons(section) -%}
{% for button in section.buttons %}<a class="btn{% if button.ghost %} ghost{% endif %}" href="{{ button.url }}">{{ button.label }}</a>{% endfor %}
{%- endmacro %}
{% macro foot(section) -%}
<div class="foot">
  {{ section.note }}{% if section.distribution %} To: {{ section.distribution | join(" · ") }}{% endif %}{% if section.links %} &nbsp;|&nbsp; {% for link in section.links %}<a href="{{ link.url }}">{{ link.label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}{% endif %}
</div>
{%- endmacro %}
{% macro genfoot(meta) -%}
<div class="genfoot">
  Generated automatically by <b>IFM NETIX AI PLATFORM</b> · Report ID {{ meta.report_id }} · Rendered {{ meta.generated_at | display_datetime }} {{ meta.timezone_label }} · Verify authenticity: Platform → Reports → Verify · © {{ meta.generated_at.year }} IFM NETIX
</div>
{%- endmacro %}
{% macro footer(section, meta) -%}
{{ buttons(section) }}
{{ foot(section) }}
{{ genfoot(meta) }}
{%- endmacro %}
