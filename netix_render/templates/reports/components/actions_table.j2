{% import "components/section_h2.j2" as heading %}
{% macro actions_table(section) -%}
{{ heading.section_h2(section.title, section.icon, section.subtitle) }}
{% set with_source = section.rows | selectattr("source") | list | length > 0 %}
{% if section.rows %}
<table class="responsive-table">
  <tr>
    <th>Action</th>
    <th>Due</th>
    <th>Owner</th>
    {% if with_source %}<th>Source</th>{% endif %}
  </tr>
  {% for row in section.rows %}
  <tr>
    <td data-label="Action" class="b">{{ row.action }}</td>
    <td data-label="Due">{{ row.due }}</td>
    <td data-label="Owner">{{ row.owner }}</td>
    {% if with_source %}<td data-label="Source">{{ row.source or "—" }}</td>{% endif %}
  </tr>
  {% endfor %}
</table>
{% elif not section.subtitle %}<p class="empty">No items supplied for this section.</p>{% endif %}
{%- endmacro %}
