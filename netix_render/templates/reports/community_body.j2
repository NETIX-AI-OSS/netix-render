<main class="report-pages community">
  <article class="report-page cover" aria-label="{{ copy.cover }}" id="report-cover">
    {% if cover_image %}<img class="cover-photo" src="{{ cover_image }}" alt="{{ copy.cover_image }}" />{% endif %}
    <div class="cover-heading">
      <div class="cover-kicker">{{ doc.meta.tag_line }}</div>
      <h1>{{ doc.meta.title | replace(doc.meta.asset.name ~ ', ', '') | replace(doc.meta.asset.name ~ ' \u2014 ', '') }}</h1>
      <p>{{ doc.meta.asset.name }}</p>
    </div>
    <div class="cover-panel">
      <div class="cover-meta">
        <div><span>{{ copy.site }}</span><strong>{{ doc.meta.asset.name }}</strong></div>
        <div><span>{{ copy.period }}</span><strong>{{ doc.meta.period.label }}</strong></div>
        <div><span>{{ copy.prepared_for }}</span><strong>{{ doc.meta.logo_line or copy.team }}</strong></div>
        <div><span>{{ copy.location }}</span><strong>{{ doc.meta.asset.location or doc.meta.asset.name }}</strong></div>
        <div><span>{{ copy.reference }}</span><strong>{{ doc.meta.report_id }}</strong></div>
        <div><span>{{ copy.generated }}</span><strong>{{ doc.meta.generated_at | display_datetime(doc.meta.language) }} {{ doc.meta.timezone_label }}</strong></div>
      </div>
      <div class="cover-contents"><span>{{ copy.contents }}</span><ol>{% for page in pages %}<li><a href="#report-page-{{ loop.index }}">{{ page.title }}</a></li>{% endfor %}</ol></div>
      <p class="cover-source">{{ copy.cover_source }}</p>
    </div>
  </article>
  {% for page in pages %}
  <article class="report-page" id="report-page-{{ loop.index }}" aria-label="{{ page.title }}">
    <header class="community-header"><strong>{{ doc.meta.logo_line or copy.facilities }}</strong><span>{{ doc.meta.asset.name }} · {{ doc.meta.period.label }}</span></header>
    <div class="page-body">
      <h1 class="page-title">{{ loop.index }}. {{ page.title }}</h1>
      {% if management %}
        {% include "reports/management_body.j2" %}
      {% elif page.detail %}
      {% set item = page.detail %}
      <p class="detail-lead">{{ item.finding }}</p>
      <div class="asset-links">{% for link in links_for(item.evidence | map(attribute="source") | join(";")) %}<a href="{{ link.url }}">{{ link.label }} · {{ copy.view_viz }} ↗</a>{% endfor %}</div>
      {% if item.evidence | selectattr('source', 'hourly_source') | list %}
        {% for chart in analysis_charts if chart.kind == 'line' %}<h2>{{ chart.title }}</h2>{{ analysis_chart(chart, true) }}<p class="analysis-note">{{ chart.note }}</p>{% endfor %}
      {% endif %}
      <div class="community-columns">
        <section class="evidence-column"><h2>{{ copy.evidence }}</h2>
          {% for record in item.evidence %}<div class="evidence-record"><b>{{ record.label }}</b><p>{{ record.observation }}</p><small>{{ record.context }} · {{ record.source }} · {{ record.evidence_id }}</small>{% for link in links_for(record.source) %}<a class="evidence-link" href="{{ link.url }}">{{ link.label }} · {{ copy.view_viz }} ↗</a>{% endfor %}</div>{% endfor %}
        </section>
        <aside class="comment-column">
          <div class="comment"><h2>{{ copy.impact }}</h2><p>{{ item.impact }}</p><h3>{{ copy.uncertain }}</h3><p>{{ item.uncertainty }}</p></div>
          <div class="comment"><h2>{{ copy.action }}</h2><p>{{ item.action }}</p><p class="owner"><b>{{ copy.owner }}</b> {{ item.owner }}</p><h3>{{ copy.steps }}</h3><ol>{% for check in item.checks %}<li>{{ check }}</li>{% endfor %}</ol></div>
        </aside>
      </div>
      {% elif page.headlines %}
        {% for section in page.sections if section.kind in ['banner', 'kpi_grid'] %}{{ render_section(section) }}{% endfor %}
        <div class="community-columns overview-columns">
          <section class="overview-evidence">{% if analysis_charts %}{% for chart in analysis_charts if chart.kind != 'line' %}<h2>{{ chart.title }}</h2>{{ analysis_chart(chart) }}<p class="analysis-note">{{ chart.note }}</p>{% endfor %}{% else %}{% for section in page.sections if section.kind not in ['banner', 'kpi_grid', 'ai_insight', 'footer'] %}{{ render_section(section) }}{% endfor %}{% endif %}</section>
          <aside>{% for section in page.sections if section.kind == 'ai_insight' %}{{ render_section(section) }}{% endfor %}
            <h2>{{ copy.findings }}</h2>{% for item in page.headlines %}<a class="headline-link" href="#report-page-{{ loop.index + 1 }}"><span>{{ loop.index }}</span>{{ item.title }}</a><div class="asset-links">{% for link in links_for(item.evidence | map(attribute="source") | join(";")) %}<a href="{{ link.url }}">{{ link.label }} ↗</a>{% endfor %}</div>{% endfor %}
          </aside>
        </div>
      {% else %}
        {% for section in page.sections if section.kind != 'footer' %}{{ render_section(section) }}{% endfor %}
      {% endif %}
      {% for section in page.sections if section.kind == 'footer' %}{{ render_section(section) }}{% endfor %}
    </div>
    <footer class="page-foot"><span>{{ doc.meta.logo_line or copy.facilities_report }} · {{ doc.meta.report_id }}</span><span>{{ copy.page_of | format(page=loop.index + 1, total=pages | length + 1) }}</span></footer>
  </article>
  {% endfor %}
</main>
