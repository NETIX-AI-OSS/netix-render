<main class="report-pages">
  <nav class="page-nav" aria-label="{{ copy.page_navigation }}">
    {% for page in pages %}<a href="#report-page-{{ loop.index }}">{{ loop.index }}. {{ page.title }}</a>{% endfor %}
  </nav>
  {% for page in pages %}
  <article class="report-page" id="report-page-{{ loop.index }}" aria-label="{{ page.title }}">
    <div class="page-body">
      <div class="page-kicker">{% if doc.meta.logo_line %}{{ doc.meta.logo_line }} · {% endif %}{{ doc.meta.asset.name }}</div>
      <h1 class="page-title">{{ page.title }}</h1>
      <div class="page-period">{{ doc.meta.period.label | isolate_value(doc.meta.dir) }} · {{ doc.meta.title | isolate_value(doc.meta.dir) }}</div>
      {% if page.detail %}
        {% set item = page.detail %}
        <p class="detail-lead">{{ item.finding }}</p>
        <div class="detail-grid">
          <div class="detail-block"><h2>{{ copy.page_impact }}</h2><p>{{ item.impact }}</p></div>
          <div class="detail-block"><h2>{{ copy.uncertain }}</h2><p>{{ item.uncertainty }}</p></div>
        </div>
        <h2 class="evidence-heading">{{ copy.headline_evidence }}</h2>
        {% for record in item.evidence %}
        <div class="evidence-record"><b>{{ record.label }}</b> · {{ record.observation }}
          <small>{{ record.context }} · {{ record.source }} · {{ record.evidence_id }}</small>
        </div>
        {% endfor %}
        <div class="detail-grid">
          <div class="detail-block"><h2>{{ copy.steps }}</h2><ol>{% for check in item.checks %}<li>{{ check }}</li>{% endfor %}</ol></div>
          <div class="detail-block detail-action"><h2>{{ copy.action }} · {{ item.owner }}</h2><p>{{ item.action }}</p></div>
        </div>
      {% endif %}
      {% for section in page.sections %}{{ render_section(section) }}{% endfor %}
      {% if page.headlines %}
      <h2>{{ copy.deep_dives }}</h2>
      {% for item in page.headlines %}<a class="headline-link" href="#report-page-{{ loop.index + 1 }}"><span>{{ loop.index }}</span>{{ item.title }} →</a>{% endfor %}
      {% endif %}
    </div>
    <footer class="page-foot"><span>{{ doc.meta.report_id }} · {{ copy.generated }} {{ genbar_c.timestamp(doc.meta) }}</span><span>{{ loop.index }} / {{ pages | length }}</span></footer>
  </article>
  {% endfor %}
</main>
