{% macro asset_links(item) -%}
<div class="asset-links">{% for link in links_for(item.evidence | map(attribute="source") | join(";")) %}<a href="{{ link.url }}">{{ link.label }} ↗</a>{% endfor %}</div>
{%- endmacro %}

{% macro evidence_list(item, title, show_source=false) -%}
<section>
  <h3>{{ title }}</h3>
  {% for record in item.evidence %}
  <p class="compact-evidence"{% if show_source %} data-source="{{ record.source }}"{% endif %}><b>{{ record.label }}</b><br>{{ record.observation | evidence_text }}</p>
  {% endfor %}
</section>
{%- endmacro %}

{% macro implication(item, title, action_title) -%}
<aside class="comment">
  <h3>{{ title }}</h3>
  <p>{{ item.impact | evidence_text }}</p>
  <h3>{{ action_title | format(owner=item.owner) }}</h3>
  <p>{{ item.action | evidence_text }}</p>
  <p class="limitation">{{ item.uncertainty | replace('WARNING: ', '') }}</p>
</aside>
{%- endmacro %}

{% macro finding(item) -%}
<section class="management-finding">
  <h2>{{ item.title | replace(doc.meta.asset.name ~ ' · ', '') }}</h2>
  <p class="takeaway">{{ item.finding | evidence_text }}</p>
  {{ asset_links(item) }}
  <div class="finding-grid">
    {{ evidence_list(item, management_copy.evidence, true) }}
    {{ implication(item, management_copy.management_implication, management_copy.next_step) }}
  </div>
</section>
{%- endmacro %}

{% if page.role == 'executive' %}
  <div class="executive-brief">{% for section in page.sections %}<p>{{ section.text | bold_markup }}</p>{% endfor %}</div>
  <div class="management-metrics">{% for metric in management.metrics %}<div><span>{{ metric.label }}</span><strong>{{ metric.value }}</strong><small>{{ metric.note }}</small></div>{% endfor %}</div>
  <h2>{{ management_copy.workload }}</h2>
  <table class="family-table">
    <thead>
      <tr><th>{{ management_copy.alarm_family }}</th><th>{{ management_copy.events }}</th><th>{{ management_copy.equipment }}</th><th>{{ management_copy.share }}</th></tr>
    </thead>
    <tbody>
      {% for row in management.families %}
      <tr><td>{{ row.label }}</td><td>{{ row.count }}</td><td>{{ row.equipment_count }}</td><td><bdi dir="ltr">{{ '%.1f' | format(row.share_pct) }}%</bdi></td></tr>
      {% endfor %}
    </tbody>
  </table>
  <div class="management-chart-row">
    <section>
      {% for chart in analysis_charts if chart.kind == 'stacked' %}<h2>{{ chart.title }}</h2>{{ analysis_chart(chart, count_axis=true) }}{% endfor %}
      <p class="analysis-note">{{ management_copy.daily_counts }}</p>
    </section>
    <aside class="comment">
      <h3>{{ management_copy.what_changed }}</h3>
      <p>{{ management.comparison_summary }}</p>
      {% for row in management.comparison_rows %}<p><b>{{ row.label }}</b><br>{{ row.summary }}</p>{% endfor %}
    </aside>
  </div>
  <p class="coverage-note">{{ management.coverage }}</p>
{% elif page.role == 'plant' %}
  {% set item = page.detail %}
  <h2>{{ item.title | replace(doc.meta.asset.name ~ ' · ', '') }}</h2>
  <p class="takeaway">{{ item.finding | evidence_text }}</p>{{ asset_links(item) }}
  {% for chart in analysis_charts if chart.kind == 'line' %}<h2>{{ chart.title }}</h2>{{ analysis_chart(chart, true) }}<p class="analysis-note">{{ chart.note }}</p>{% endfor %}
  <div class="finding-grid">
    {{ evidence_list(item, management_copy.measured_evidence) }}
    {{ implication(item, management_copy.operating_implication, management_copy.required_check) }}
  </div>
{% elif page.role == 'supporting' %}
  {% for section in page.sections %}{{ render_section(section) }}{% endfor %}
{% elif page.role == 'priorities' %}
  <p class="takeaway">{{ management_copy.planning_note }}</p>
  <table class="action-register">
    <thead>
      <tr><th>{{ management_copy.priority_owner }}</th><th>{{ management_copy.action_evidence }}</th></tr>
    </thead>
    <tbody>
      {% for section in page.sections %}{% for row in section.rows %}
      <tr>
        <td><b>{{ loop.index }} · {{ row.owner }}</b><p>{{ management_copy.proposed_due | format(due=row.due) }}</p></td>
        <td><b>{{ row.action }}</b><div class="asset-links">{% for link in action_links(row) %}<a href="{{ link.url }}">{{ link.label }} ↗</a>{% endfor %}</div></td>
      </tr>
      {% endfor %}{% endfor %}
    </tbody>
  </table>
  <div class="coverage-note">
    <b>{{ management_copy.how_to_use }}</b>
    <p>{{ management_copy.report_limits }}</p>
    <p>{{ management.coverage }}</p>
  </div>
{% else %}
  {% for item in page.headlines %}{{ finding(item) }}{% endfor %}
{% endif %}
