{% extends "email/base.html.j2" %}
{% import "email/macros.j2" as m %}
{% import "email/connectivity.j2" as cx with context %}
{% set end = "left" if payload.meta.dir == "rtl" else "right" %}
{% set kinds = {"asset": t("kind_asset"), "gateway": t("kind_gateway")} %}
{% set incident_kinds = {"gateway": t("kind_gateway"), "building": t("building"), "single": t("kind_device")} %}
{% set band_state = {"crit": "offline", "warn": "degraded", "ok": "ok"} %}
{% macro count(value) %}{{ value if value else "-" }}{% endmacro %}
{% macro excluded_note() -%}
{% set excluded = ([t("count_snoozed", count=payload.snoozed_count)] if payload.snoozed_count else [])
  + ([t("count_in_maintenance", count=payload.maintenance_count)] if payload.maintenance_count else []) %}
{% if excluded %}<p class="small">{{ t("not_included", items=excluded | join(t("list_separator"))) }}</p>{% endif %}
{%- endmacro %}
{% block styles %}{% include "email/connectivity.css.j2" %}{% endblock %}
{% block content %}
{% set totals = payload.totals %}
{% set availability = cx.pct(payload.availability_value) %}
{% if payload.all_clear %}
<div class="band cx-band-ok">{{ cx.icon("ok") }} {{ t("all_clear_heading") }}</div>
<p class="p mut">{{ payload.report_name }}. {{ t("report_date_tz", date=payload.report_date, timezone=payload.timezone) }}</p>
<p class="p">{{ t("all_clear_body") }}</p>
<table class="kpi" cellpadding="0" cellspacing="4">
  <tr>
    {{ cx.kpi(totals.monitored, t("monitored"), width=33) }}
    {{ cx.kpi(availability, t("availability_24h"), sub=payload.availability_delta or "", width=33) }}
    {{ cx.kpi(payload.movement.recovered_24h, t("back_online"), width=34) }}
  </tr>
</table>
{{ excluded_note() }}
{% else %}
<div class="band cx-band-{{ payload.severity }}">{{ cx.icon(band_state[payload.severity]) }} {{ payload.report_name }}</div>
<p class="p mut">{{ t("report_date_tz", date=payload.report_date, timezone=payload.timezone) }}</p>
{% if payload.all_online %}<p class="p">{{ t("all_online") }}</p>{% endif %}
{% set moved = payload.movement %}
{% set vs = moved.new_vs_yesterday %}
{% set vs_text = "" if vs is none else t("vs_yesterday_more", count=vs) if vs > 0 else t("vs_yesterday_fewer", count=-vs) if vs < 0 else t("vs_yesterday_same") %}
<p class="kpi-cap">{{ t("changes_since_yesterday") }}</p>
<table class="kpi" cellpadding="0" cellspacing="4">
  <tr>
    {{ cx.kpi(moved.new_24h, t("went_offline"), "offline" if moved.new_24h else "", sub=vs_text) }}
    {{ cx.kpi(moved.recovered_24h, t("back_online")) }}
    {{ cx.kpi(moved.still_down, t("still_down"), "offline" if moved.still_down else "") }}
    {{ cx.kpi(availability, t("availability_24h"), sub=payload.availability_delta or "") }}
  </tr>
</table>
<p class="kpi-cap">{{ t("kpi_now") }}</p>
<table class="kpi" cellpadding="0" cellspacing="4">
  <tr>
    {{ cx.kpi(totals.monitored, t("monitored")) }}
    {{ cx.kpi(totals.online, t("online"), "online") }}
    {{ cx.kpi(totals.degraded, t("degraded"), "degraded" if totals.degraded else "") }}
    {{ cx.kpi(totals.offline, t("offline"), "offline" if totals.offline else "") }}
  </tr>
</table>
{{ excluded_note() }}
{% if payload.incidents %}
<p class="h2">{{ t("incidents") }}</p>
<table class="kv" cellpadding="0" cellspacing="0">
  {% for incident in payload.incidents %}
  {% set affected_key = "assets_unreachable" if incident.kind == "gateway" else "devices_affected" %}
  <tr>
    <td>
      <span class="cx-chip">{{ incident_kinds[incident.kind] }}</span>
      <b>{{ cx.name_link(incident.title, incident.link) }}</b>
      {% if incident.since or incident.duration %}<div class="cx-meta">{% if incident.since %}{{ t("since") }} {{ incident.since }}{% endif %}{% if incident.since and incident.duration %} · {% endif %}{{ incident.duration or "" }}</div>{% endif %}
    </td>
    <td class="v" style="text-align: {{ end }}; white-space: nowrap">
      {% if incident.kind != "single" or incident.affected > 1 %}{{ t(affected_key ~ ("_one" if incident.affected == 1 else "_other"), count=incident.affected) }}{% endif %}
    </td>
  </tr>
  {% endfor %}
</table>
{% endif %}
{% if not payload.all_online %}
<p class="h2">{{ cx.icon("offline") }} {{ t("offline_now") }}</p>
{% if payload.offline_items %}
<table class="kv" cellpadding="0" cellspacing="0">
  <tr>
    <th>{{ t("name") }}</th>
    <th>{{ t("type") }}</th>
    <th>{{ t("building") }}</th>
    <th>{{ t("since") }}</th>
    <th style="text-align: {{ end }}">{{ t("duration") }}</th>
  </tr>
  {% for item in payload.offline_items %}
  <tr>
    <td class="v">{{ cx.name_link(item.display_name, item.link) }}</td>
    <td>{{ kinds.get(item.subject_kind, item.subject_kind) or "-" }}</td>
    <td>{{ item.building or "-" }}</td>
    <td>{{ item.since or "-" }}</td>
    <td style="text-align: {{ end }}">{{ item.duration or "-" }}</td>
  </tr>
  {% endfor %}
</table>
{% if payload.offline_more > 0 %}<p class="small">{{ t("more_offline", count=payload.offline_more) }}</p>{% endif %}
{% else %}
<p class="p mut">{{ t("nothing_offline") }}</p>
{% endif %}
{% endif %}
{% if payload.by_building %}
<p class="h2">{{ t("by_building") }}</p>
<table class="kv" cellpadding="0" cellspacing="0">
  <tr>
    <th>{{ t("building") }}</th>
    <th style="text-align: {{ end }}">{{ t("monitored") }}</th>
    <th style="text-align: {{ end }}">{{ cx.icon("offline") }} {{ t("offline") }}</th>
    <th style="text-align: {{ end }}">{{ cx.icon("degraded") }} {{ t("degraded") }}</th>
  </tr>
  {% for row in payload.by_building %}
  <tr>
    <td class="v">{{ row.building }}</td>
    <td style="text-align: {{ end }}">{{ row.monitored }}</td>
    <td class="{{ 'v cx-offline' if row.offline else '' }}" style="text-align: {{ end }}">{{ count(row.offline) }}</td>
    <td class="{{ 'v cx-degraded' if row.degraded else '' }}" style="text-align: {{ end }}">{{ count(row.degraded) }}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}
{% if payload.gateway_impact %}
<p class="h2">{{ t("gateway_impact") }}</p>
<table class="kv" cellpadding="0" cellspacing="0">
  <tr>
    <th>{{ t("gateway") }}</th>
    <th>{{ t("since") }}</th>
    <th style="text-align: {{ end }}">{{ t("assets_affected") }}</th>
  </tr>
  {% for gateway in payload.gateway_impact %}
  <tr>
    <td class="v">{{ gateway.display_name }}</td>
    <td>{{ gateway.since or "-" }}</td>
    <td style="text-align: {{ end }}">{{ gateway.affected_assets }}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}
{% endif %}
{% if payload.attachment_note %}<p class="p">{{ payload.attachment_note }}</p>{% endif %}
{{ m.cta_button({"label": t("open_dashboard"), "url": payload.dashboard_url}) }}
{% endblock %}
