{% extends "email/base.html.j2" %}
{% import "email/macros.j2" as m %}
{% set end = "left" if payload.meta.dir == "rtl" else "right" %}
{% set kinds = {"asset": t("kind_asset"), "gateway": t("kind_gateway")} %}
{% macro kpi(value, label, level="", width=25) -%}
<td width="{{ width }}%">
  <div class="kpi-n{% if level %} kpi-{{ level }}{% endif %}">{{ value }}</div>
  <div class="kpi-l">{{ label }}</div>
</td>
{%- endmacro %}
{% macro compact_cell(label, value, is_name=false, align_end=false) -%}
<td{% if is_name %} class="v"{% endif %}{% if align_end %} style="text-align: {{ end }}"{% endif %}>
  <span class="compact-label">{{ t(label) }}</span><span>{{ value | string | isolate_value(payload.meta.dir) }}</span>
</td>
{%- endmacro %}
{% macro count(value) %}{{ value if value else "-" }}{% endmacro %}
{% block responsive_styles %}
      .compact-label {
        display: none;
      }
      @media screen and (max-width: 480px) {
        .compact-kpi tr {
          display: flex;
          flex-wrap: wrap;
          gap: 4px;
        }
        .compact-kpi td {
          box-sizing: border-box;
          flex: 1 1 40%;
          min-width: 0;
        }
        .compact-table, .compact-table tbody, .compact-table tr {
          display: block;
        }
        .compact-table .compact-header {
          display: none;
        }
        .compact-table tr {
          padding: 6px 0;
          border-top: 1px solid {{ tokens.color.line }};
        }
        .compact-table td {
          border: 0 !important;
          display: grid;
          gap: 8px;
          grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
          padding: 3px 0 !important;
        }
        .compact-label {
          display: block !important;
          color: {{ tokens.color.ink_soft }};
          font-weight: 400;
          text-align: start;
        }
      }
{% endblock %}
{% block content %}
<div class="band band-{{ payload.severity }}">{{ payload.report_name }}</div>
<p class="p mut">{{ t("report_date_tz", date=payload.report_date | isolate_value(payload.meta.dir), timezone=payload.timezone | isolate_value(payload.meta.dir)) }}</p>
{% if payload.all_online %}<p class="p">{{ t("all_online") }}</p>{% endif %}
<p class="kpi-cap">{{ t("kpi_now") }}</p>
<table class="kpi compact-kpi" cellpadding="0" cellspacing="4">
  <tr>
    {{ kpi(payload.totals.monitored, t("monitored")) }}
    {{ kpi(payload.totals.online, t("online")) }}
    {{ kpi(payload.totals.degraded, t("degraded"), "warn" if payload.totals.degraded else "") }}
    {{ kpi(payload.totals.offline, t("offline"), "crit" if payload.totals.offline else "") }}
  </tr>
</table>
<p class="kpi-cap">{{ t("kpi_last_24h") }}</p>
<table class="kpi compact-kpi" cellpadding="0" cellspacing="4">
  <tr>
    {% set availability = payload.availability_value %}
    {{ kpi(t("percent", value=availability.replace(".", t("decimal_separator"))) if availability is not none else "-", t("availability"), width=33) }}
    {{ kpi(payload.new_24h, t("went_offline"), "crit" if payload.new_24h else "", width=33) }}
    {{ kpi(payload.recovered_24h, t("back_online"), width=34) }}
  </tr>
</table>
{% if not payload.all_online %}
<p class="h2">{{ t("offline_now") }}</p>
{% if payload.offline_items %}
<table class="kv compact-table" cellpadding="0" cellspacing="0">
  <tr class="compact-header">
    <th>{{ t("name") }}</th>
    <th>{{ t("type") }}</th>
    <th>{{ t("building") }}</th>
    <th>{{ t("since") }}</th>
    <th style="text-align: {{ end }}">{{ t("duration") }}</th>
  </tr>
  {% for item in payload.offline_items %}
  <tr>
    {{ compact_cell("name", item.display_name, is_name=true) }}
    {{ compact_cell("type", kinds.get(item.subject_kind, item.subject_kind) or "-") }}
    {{ compact_cell("building", item.building or "-") }}
    {{ compact_cell("since", item.since or "-") }}
    {{ compact_cell("duration", item.duration or "-", align_end=true) }}
  </tr>
  {% endfor %}
</table>
{% if payload.offline_more > 0 %}<p class="small">{{ t("more_offline", count=payload.offline_more) }}</p>{% endif %}
{% else %}
<p class="p mut">{{ t("nothing_offline") }}</p>
{% endif %}
{% endif %}
{% if payload.by_building %}
<p class="h2">{{ t("by_building") }}</p>
<table class="kv compact-table" cellpadding="0" cellspacing="0">
  <tr class="compact-header">
    <th>{{ t("building") }}</th>
    <th style="text-align: {{ end }}">{{ t("monitored") }}</th>
    <th style="text-align: {{ end }}">{{ t("offline") }}</th>
    <th style="text-align: {{ end }}">{{ t("degraded") }}</th>
  </tr>
  {% for row in payload.by_building %}
  <tr>
    {{ compact_cell("building", row.building, is_name=true) }}
    {{ compact_cell("monitored", row.monitored, align_end=true) }}
    {{ compact_cell("offline", count(row.offline), align_end=true) }}
    {{ compact_cell("degraded", count(row.degraded), align_end=true) }}
  </tr>
  {% endfor %}
</table>
{% endif %}
{% if payload.gateway_impact %}
<p class="h2">{{ t("gateway_impact") }}</p>
<table class="kv compact-table" cellpadding="0" cellspacing="0">
  <tr class="compact-header">
    <th>{{ t("gateway") }}</th>
    <th>{{ t("since") }}</th>
    <th style="text-align: {{ end }}">{{ t("assets_affected") }}</th>
  </tr>
  {% for gateway in payload.gateway_impact %}
  <tr>
    {{ compact_cell("gateway", gateway.display_name, is_name=true) }}
    {{ compact_cell("since", gateway.since or "-") }}
    {{ compact_cell("assets_affected", gateway.affected_assets, align_end=true) }}
  </tr>
  {% endfor %}
</table>
{% endif %}
{% if payload.attachment_note %}<p class="p">{{ payload.attachment_note }}</p>{% endif %}
{{ m.cta_button({"label": t("open_dashboard"), "url": payload.dashboard_url}) }}
{% endblock %}
