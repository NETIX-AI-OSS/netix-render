{% extends "email/base.html.j2" %}
{% import "email/macros.j2" as m %}
{% block content %}
<h1 class="h1">{{ t("report_ready") }}</h1>
{% if payload.report_label %}<p class="p">{{ payload.report_label }}</p>{% endif %}
<table class="kv" cellpadding="0" cellspacing="0">
  <tr>
    <td class="v">{{ payload.file_name }}</td>
  </tr>
</table>
{{ m.cta_button({"label": t("download"), "url": payload.download_url}) }}
{% if payload.expiry_note %}<p class="small">{{ payload.expiry_note }}</p>{% endif %}
{% endblock %}
