{#- Email-safe chrome: 600px table frame, all styles inlined downstream by css-inline. -#}
<!doctype html>
<html lang="{{ payload.meta.locale }}" dir="{{ payload.meta.dir }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>{{ subject }}</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background: {{ tokens.color.surface_soft }};
        font-family: {{ tokens.font_stack }};
        color: {{ tokens.color.ink }};
      }
      .canvas {
        background: {{ tokens.color.surface_soft }};
      }
      .frame {
        width: {{ tokens.email.frame_width }}px;
        max-width: 100%;
      }
      .mast-td {
        background: {{ tokens.color.primary }};
        border-radius: {{ tokens.email.radius }}px {{ tokens.email.radius }}px 0 0;
        padding: 18px 24px;
      }
      .wordmark {
        font-size: 15px;
        font-weight: 800;
        letter-spacing: 1.2px;
        color: {{ tokens.color.primary_contrast }};
      }
      .wordmark span {
        color: {{ tokens.color.accent }};
      }
      .org-name {
        font-size: 11px;
        color: #cfe2ee;
        letter-spacing: 0.6px;
        padding-top: 4px;
      }
      .sheet-td {
        background: {{ tokens.color.surface }};
        border: 1px solid {{ tokens.color.line }};
        border-top: none;
        border-radius: 0 0 {{ tokens.email.radius }}px {{ tokens.email.radius }}px;
        padding: 24px;
      }
      .h1 {
        font-size: 18px;
        font-weight: 700;
        margin: 0 0 12px;
        color: {{ tokens.color.ink }};
      }
      .p {
        font-size: 13.5px;
        line-height: 1.6;
        margin: 8px 0;
        color: {{ tokens.color.ink }};
      }
      .mut {
        color: {{ tokens.color.ink_soft }};
      }
      .small {
        font-size: 11.5px;
        color: {{ tokens.color.ink_faint }};
        line-height: 1.5;
      }
      .kv {
        width: 100%;
        border-collapse: collapse;
        font-size: 12.5px;
        margin: 12px 0;
      }
      .kv th {
        text-align: {{ "right" if payload.meta.dir == "rtl" else "left" }};
        color: {{ tokens.color.ink_soft }};
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        padding: 7px 10px;
        border-bottom: 1px solid {{ tokens.color.line }};
        background: {{ tokens.color.surface_soft }};
      }
      .kv td {
        padding: 7px 10px;
        border-bottom: 1px solid {{ tokens.color.line }};
        vertical-align: top;
      }
      .kv td.k {
        color: {{ tokens.color.ink_soft }};
        width: 38%;
      }
      .kv td.v {
        font-weight: 600;
      }
      .pill {
        display: inline-block;
        font-size: 10px;
        font-weight: 800;
        padding: 2px 10px;
        border-radius: 10px;
        letter-spacing: 0.4px;
      }
      .p-ok {
        background: {{ tokens.color.status_soft.ok }};
        color: {{ tokens.color.status.ok }};
      }
      .p-warn {
        background: {{ tokens.color.status_soft.warn }};
        color: {{ tokens.color.status.warn }};
      }
      .p-crit {
        background: {{ tokens.color.status_soft.crit }};
        color: {{ tokens.color.status.crit }};
      }
      .p-grey {
        background: {{ tokens.color.status_soft.muted }};
        color: {{ tokens.color.ink_soft }};
      }
      .band {
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 13px;
        font-weight: 700;
        margin: 0 0 12px;
      }
      .band-ok {
        background: {{ tokens.color.status_soft.ok }};
        color: {{ tokens.color.status.ok }};
      }
      .band-warn {
        background: {{ tokens.color.status_soft.warn }};
        color: {{ tokens.color.status.warn }};
      }
      .band-crit {
        background: {{ tokens.color.status_soft.crit }};
        color: {{ tokens.color.status.crit }};
      }
      .btn-td {
        background: {{ tokens.color.primary }};
        border-radius: 8px;
        padding: 10px 20px;
      }
      .btn-td a {
        color: {{ tokens.color.primary_contrast }};
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
      }
      .code {
        font-size: 26px;
        font-weight: 800;
        letter-spacing: 6px;
        color: {{ tokens.color.primary }};
        padding: 12px 0;
      }
      .foot-td {
        padding: 16px 6px 0;
        font-size: 11px;
        color: {{ tokens.color.ink_faint }};
        line-height: 1.6;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <table class="canvas" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center" style="padding: 20px 12px 36px">
          <table class="frame" cellpadding="0" cellspacing="0">
            <tr>
              <td class="mast-td">
                {% if payload.meta.org.logo_url -%}
                <img src="{{ payload.meta.org.logo_url }}" alt="{{ payload.meta.org.name or 'logo' }}" height="28" style="display: block; max-height: 28px" />
                {%- else -%}
                <div class="wordmark">{{ tokens.email.wordmark }}<span>{{ tokens.email.wordmark_suffix }}</span></div>
                {%- endif %}
                {% if payload.meta.org.name %}<div class="org-name">{{ payload.meta.org.name }}</div>{% endif %}
              </td>
            </tr>
            <tr>
              <td class="sheet-td">
                {% block content %}{% endblock %}
              </td>
            </tr>
            <tr>
              <td class="foot-td">
                {{ t("regards") }}, {{ tokens.email.sign_off }}<br />
                {{ t("automated_note") }}
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
