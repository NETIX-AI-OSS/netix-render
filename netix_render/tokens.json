{
  "$comment": "NETIX brand tokens. Source of truth for rendered HTML (email + page). Hex values are derived from frontend-template app/assets/styles/globals.css HSL tokens; keep in sync via `netix tokens check`.",
  "version": 1,
  "font_stack": "Inter, Segoe UI, Arial, sans-serif",
  "color": {
    "primary": "#196594",
    "primary_soft": "#e1edf4",
    "primary_contrast": "#ffffff",
    "accent": "#30bce4",
    "ink": "#2d2e2f",
    "ink_soft": "#5d7482",
    "ink_faint": "#8298a4",
    "surface": "#ffffff",
    "surface_soft": "#f4f6f8",
    "line": "#e5eaf0",
    "status": {
      "ok": "#12914d",
      "warn": "#da9901",
      "crit": "#ff3838",
      "muted": "#a1b0ba"
    },
    "status_soft": {
      "ok": "#e7f6ee",
      "warn": "#fdf3dd",
      "crit": "#feeaea",
      "muted": "#eef1f4"
    },
    "print": {
      "navy": "#1F4E78",
      "grey": "#555555",
      "border": "#C9D2DA",
      "band": "#EAF0F5"
    }
  },
  "email": {
    "frame_width": 600,
    "radius": 10,
    "wordmark": "NETIX",
    "wordmark_suffix": ".AI",
    "sign_off": "NETIX.AI · CAFM Platform"
  },
  "source": {
    "frontend_globals_css": "frontend/frontend-template/app/assets/styles/globals.css",
    "hsl": {
      "primary": "hsl(203 71% 34%)",
      "primary_soft": "hsl(202 46% 92%)",
      "ink": "hsl(210 2% 18%)",
      "status.ok": "hsl(148 78% 32%)",
      "status.warn": "hsl(42 99% 43%)",
      "status.crit": "hsl(0 100% 61%)",
      "status.muted": "hsl(203 15% 68%)"
    }
  }
}
